# Ad-hoc cgroup limiting; cargo/nix-shell/claude auto-wrapped via ~/.scripts/climit-wrappers PATH shims
climit() {
  systemd-run --user --scope -q \
    -p MemoryHigh="${BUILD_MEM:-70%}" -p MemoryMax="${BUILD_MEM_MAX:-80%}" \
    -p CPUQuota="${BUILD_CPU:-600%}" "$@"
}
