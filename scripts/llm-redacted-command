#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -lt 1 ]; then
  printf 'usage: %s <command> [args...]\n' "${0##*/}" >&2
  exit 1
fi

rules_file="${LLM_REDACTOR_RULES:-$HOME/.secrets/llm.toml}"

if command -v llm-redactor-exec >/dev/null 2>&1 && [ -f "$rules_file" ]; then
  exec llm-redactor-exec --redactor-rules="$rules_file" -- "$@"
fi

exec "$@"
