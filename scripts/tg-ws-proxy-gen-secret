#!/usr/bin/env bash

# Generate a fresh MTProto secret for proxy-suite-tg-ws-proxy and reload it.
#
# The secret must be exactly 32 hex chars (16 bytes) with NO trailing newline —
# the tg-ws-proxy binary rejects anything that fails hex validation, which is
# what crashes the unit at switch-to-configuration time.

set -euo pipefail

SECRET_FILE="/etc/dynamic/tg-ws-proxy-secret"
SERVICE="proxy-suite-tg-ws-proxy.service"

if [ "$(id -u)" -ne 0 ]; then
  echo "needs root: sudo $0" >&2
  exit 1
fi

mkdir -p "$(dirname "$SECRET_FILE")"

# 16 random bytes -> 32 lowercase hex chars (od is per-byte, so byte order is safe).
secret="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"

# No trailing newline — write exactly the hex string, tight perms.
printf '%s' "$secret" > "$SECRET_FILE"
chmod 600 "$SECRET_FILE"

systemctl restart "$SERVICE"

# Report state instead of pretending success.
sleep 1
if systemctl is-active --quiet "$SERVICE"; then
  echo "OK: $SERVICE active"
  echo "secret: $secret  ($SECRET_FILE)"
else
  echo "FAIL: $SERVICE not active. Inspect:" >&2
  echo "  journalctl -u $SERVICE -n 40 --no-pager" >&2
  exit 1
fi
