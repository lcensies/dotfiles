#!/usr/bin/env python3
"""Regenerate cliproxy-models.nix from the live cli-proxy-api /v1/models list.

Layer 2 (what the proxy actually serves) -> layer 1 (what pi/omp/kilocode show).
Existing display names are preserved; new models get a derived name.
Run after the proxy is up: `cliproxy-sync-models` then rebuild home-manager.
"""
import json
import os
import re
import sys
import urllib.request

ENDPOINT = os.environ.get("CLIPROXY_ENDPOINT", "http://127.0.0.1:8317/v1/models")
OUT = os.environ.get(
    "CLIPROXY_MODELS_NIX",
    os.path.join(
        os.path.expanduser("~"),
        "repos/nixos/nixos/home-manager/config/cliproxy-models.nix",
    ),
)
FAMILIES = ("opus", "sonnet", "haiku", "fable")


def derive_name(model_id: str) -> str:
    core = model_id[len("claude-"):] if model_id.startswith("claude-") else model_id
    parts = core.split("-")
    date = None
    if parts and re.fullmatch(r"\d{8}", parts[-1]):
        date, parts = parts[-1], parts[:-1]
    fam_idx = next((i for i, p in enumerate(parts) if p in FAMILIES), None)
    if fam_idx is None:
        body = " ".join(parts)
    else:
        family = parts[fam_idx].capitalize()
        ver = ".".join(p for i, p in enumerate(parts) if i != fam_idx)
        body = f"{family} {ver}".strip()
    label = f"Claude {body}".strip()
    if date:
        label += f" ({date[4:8]})"
    return label


def existing_names(path: str) -> dict[str, str]:
    names: dict[str, str] = {}
    if not os.path.exists(path):
        return names
    with open(path) as f:
        for m in re.finditer(r'id\s*=\s*"([^"]+)"\s*;\s*name\s*=\s*"([^"]+)"', f.read()):
            names[m.group(1)] = m.group(2)
    return names


def main() -> int:
    with urllib.request.urlopen(ENDPOINT, timeout=5) as resp:
        data = json.load(resp)
    models = [m for m in data.get("data", []) if m.get("owned_by") == "anthropic"]
    models.sort(key=lambda m: m.get("created", 0), reverse=True)

    keep = existing_names(OUT)
    rows = [(m["id"], keep.get(m["id"]) or derive_name(m["id"])) for m in models]
    if not rows:
        print("No anthropic models returned; refusing to overwrite.", file=sys.stderr)
        return 1

    id_w = max(len(f'"{i}";') for i, _ in rows)
    lines = [
        "# Canonical model list exposed by local cliproxyapi.",
        "# Shared by cli-proxy-api.nix (pi) and kilocode.nix.",
        "# AUTO-GENERATED by dotfiles/scripts/cliproxy-sync-models — edit names, not ids.",
        "[",
    ]
    for i, name in rows:
        lines.append(f'  {{ id = {f'"{i}";':<{id_w}} name = "{name}"; }}')
    lines.append("]")
    with open(OUT, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Wrote {len(rows)} models -> {OUT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
